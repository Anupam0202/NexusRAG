{
  "schema_version": 1,
  "profile": "ZERO_COST_LOW_TRAFFIC",
  "provider": "cloudflare",
  "verified_at": "2026-09-12",
  "review_after": "2026-10-12",
  "unknown_quotas_fail_closed": true,
  "paid_fallback": false,
  "thresholds_percent": [50, 70, 85, 95, 100],
  "budgets": {
    "workers_requests": {"limit": 100000, "window": "day", "reset": "00:00 UTC", "unit": "requests"},
    "workers_cpu": {"limit": 10, "window": "invocation", "unit": "milliseconds"},
    "kv_reads": {"limit": 100000, "window": "day", "reset": "00:00 UTC", "unit": "keys"},
    "kv_writes": {"limit": 1000, "window": "day", "reset": "00:00 UTC", "unit": "keys"},
    "kv_deletes": {"limit": 1000, "window": "day", "reset": "00:00 UTC", "unit": "keys"},
    "kv_lists": {"limit": 1000, "window": "day", "reset": "00:00 UTC", "unit": "requests"},
    "kv_storage": {"limit": 1, "window": "account", "unit": "GB"},
    "d1_rows_read": {"limit": 5000000, "window": "day", "reset": "00:00 UTC", "unit": "rows"},
    "d1_rows_written": {"limit": 100000, "window": "day", "reset": "00:00 UTC", "unit": "rows"},
    "d1_storage": {"limit": 5, "window": "account", "unit": "GB"},
    "r2_standard_storage": {"limit": 10, "window": "month", "unit": "GB-month"},
    "r2_class_a": {"limit": 1000000, "window": "month", "unit": "operations"},
    "r2_class_b": {"limit": 10000000, "window": "month", "unit": "operations"},
    "queues_operations": {"limit": 10000, "window": "day", "unit": "operations", "message_retention_hours": 24},
    "workflows_steps": {"limit": 3000, "window": "day", "unit": "steps"},
    "workflows_storage": {"limit": 1, "window": "month", "unit": "GB-month"},
    "browser_run": {"limit": 10, "window": "day", "unit": "minutes", "concurrency": 3},
    "vectorize_queried_dimensions": {"limit": 30000000, "window": "month", "unit": "dimensions"},
    "vectorize_stored_dimensions": {"limit": 5000000, "window": "account", "unit": "dimensions"},
    "hyperdrive_queries": {"limit": 100000, "window": "day", "reset": "00:00 UTC", "unit": "statements"},
    "ai_gateway_persistent_logs": {"limit": 100000, "window": "account", "unit": "logs"},
    "turnstile_widgets": {"limit": 20, "window": "account", "unit": "widgets", "hostnames_per_widget": 10, "challenges": "unlimited"}
  },
  "sources": [
    "https://developers.cloudflare.com/workers/platform/pricing/",
    "https://developers.cloudflare.com/d1/platform/pricing/",
    "https://developers.cloudflare.com/r2/pricing/",
    "https://developers.cloudflare.com/queues/platform/pricing/",
    "https://developers.cloudflare.com/workflows/reference/pricing/",
    "https://developers.cloudflare.com/vectorize/platform/pricing/",
    "https://developers.cloudflare.com/hyperdrive/platform/pricing/",
    "https://developers.cloudflare.com/browser-run/pricing/",
    "https://developers.cloudflare.com/ai-gateway/reference/pricing/",
    "https://developers.cloudflare.com/turnstile/plans/"
  ]
}
