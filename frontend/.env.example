# Backend API URL.
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (required for enterprise mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical Cloudflare frontend URL used for production auth callbacks.
# Localhost remains local automatically during development.
NEXT_PUBLIC_SITE_URL=https://nexusrag-v6-frontend-preview.workers.dev
# Comma-separated OAuth providers exposed by the login UI.
# Keep this aligned with enabled Supabase Auth providers.
# Use "google,github" only after both providers are configured in Supabase.
NEXT_PUBLIC_OAUTH_PROVIDERS=github

# Preview/production:
# Point at the Cloudflare gateway. Do not point new deployments at Vercel,
# Render, or Railway.
# NEXT_PUBLIC_API_URL=https://nexusrag-v6-preview-gateway.<account-subdomain>.workers.dev
