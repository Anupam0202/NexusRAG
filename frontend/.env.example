# Backend API URL.
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (required for enterprise mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production:
# Set this in Vercel to the actual Render backend URL after creating the
# Render service. Do not point production builds at Railway.
# NEXT_PUBLIC_API_URL=https://your-render-service.onrender.com
