# Backend API URL.
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (required for enterprise mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical public frontend URL used for production auth callbacks.
# Localhost remains local automatically during development.
NEXT_PUBLIC_SITE_URL=https://nexusrag.vercel.app

# Production:
# Set this in Vercel to the actual Render backend URL after creating the
# Render service. Do not point production builds at Railway.
# NEXT_PUBLIC_API_URL=https://your-render-service.onrender.com
