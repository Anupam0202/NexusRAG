+export type ProcurementEvidenceState="READY"|"SOURCE_UNAVAILABLE"|"REVIEW_REQUIRED"|"RIGHTS_BLOCKED";
+export type ProcurementEvidenceSummary={finding_id:string;revision:number;run_id:string;result_index:number;created_at:string;updated_at:string;
+  state:ProcurementEvidenceState;source_state:"CURRENT"|"UNAVAILABLE_OR_CHANGED";review_state:"APPROVED"|"REVIEW_REQUIRED"|"CHANGES_REQUESTED";rights_state:"ALLOWED"|"RIGHTS_BLOCKED"};
+export type ProcurementEvidenceList={schema_version:"procurement-evidence-list/1";workspace_id:string;action:ServingAction;items:ProcurementEvidenceSummary[];next_after:string|null};
