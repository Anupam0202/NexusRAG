{
  "name": "nexusrag-v6-pr3-gateway",
  "main": "src/preview-worker.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "nexusrag-v6-pr3-ingestion"
      }
    ],
    "consumers": [
      {
        "queue": "nexusrag-v6-pr3-ingestion",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "nexusrag-v6-pr3-ingestion-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
