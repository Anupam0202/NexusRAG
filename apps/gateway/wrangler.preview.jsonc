{
  "name": "nexusrag-v6-candidate-gateway",
  "main": "src/preview-worker.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true
  },
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "nexusrag-v6-candidate-ingestion"
      }
    ],
    "consumers": [
      {
        "queue": "nexusrag-v6-candidate-ingestion",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "nexusrag-v6-candidate-ingestion-dlq",
        "max_concurrency": 1
      }
    ]
  },
  // Each user's requests per minute, counted by Cloudflare across the Worker's isolates in a location (NX-25).
  // The preview and production keep separate counters.
  "ratelimits": [
    {
      "name": "USER_RATE_LIMITER",
      "namespace_id": "4201",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
